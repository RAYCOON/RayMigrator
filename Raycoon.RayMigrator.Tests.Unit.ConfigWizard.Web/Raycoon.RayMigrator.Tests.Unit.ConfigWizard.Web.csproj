<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Suppress WASM-specific build targets that don't apply to test projects -->
    <_BlazorWebAssemblyHosted>false</_BlazorWebAssemblyHosted>
    <RazorCompileOnBuild>false</RazorCompileOnBuild>
    <RazorCompileOnPublish>false</RazorCompileOnPublish>
    <UseRazorSourceGenerator>false</UseRazorSourceGenerator>
    <EnableDefaultRazorItems>false</EnableDefaultRazorItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Raycoon.RayMigrator.ConfigWizard.Core\Raycoon.RayMigrator.ConfigWizard.Core.csproj" />
    <ProjectReference Include="..\Raycoon.RayMigrator.ConfigWizard.Web\Raycoon.RayMigrator.ConfigWizard.Web.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>default</LangVersion>
        <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
        <PackageId>Raycoon.RayMigrator.Shared</PackageId>
        <Version>$(RayMigratorVersion)</Version>
        <Authors>RAYCOON.com GmbH</Authors>
        <Description>Shared types, exceptions, and constants for RayMigrator</Description>
        <PackageTags>raymigrator;shared</PackageTags>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\NUGET_README.md" Pack="true" PackagePath="README.md" />
    </ItemGroup>

</Project>

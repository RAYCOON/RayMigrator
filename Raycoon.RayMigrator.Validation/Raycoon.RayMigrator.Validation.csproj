<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>default</LangVersion>
        <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
        <PackageId>Raycoon.RayMigrator.Validation</PackageId>
        <Version>$(RayMigratorVersion)</Version>
        <Authors>RAYCOON.com GmbH</Authors>
        <Description>Shared validation rule catalog for RayMigrator (WASM-safe, dependency-free). Licensed under BUSL-1.1 with Additional Use Grant — see LICENSE.md.</Description>
        <IsPackable>true</IsPackable>
        <PackageTags>$(RayMigratorBaseTags);raymigrator;validation</PackageTags>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\NUGET_README.md" Pack="true" PackagePath="README.md" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Raycoon.RayMigrator.Tests.Unit.Validation" />
    </ItemGroup>

    <!-- ZERO NuGet PackageReferences, ZERO ProjectReferences. WASM-safe by construction. -->
</Project>

<Project>
  <PropertyGroup>
    <RayMigratorVersion>0.10.3</RayMigratorVersion>
    <Version>$(RayMigratorVersion)</Version>
    <!-- NuGet Metadata (global for all packages) -->
    <Authors>Daniel Pavic (RAYCOON.com GmbH)</Authors>
    <Company>RAYCOON.com GmbH</Company>
    <Copyright>Copyright (c) 2023-$([System.DateTime]::Now.Year) RAYCOON.com GmbH</Copyright>
    <PackageProjectUrl>https://raymigrator.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/RAYCOON/RayMigrator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <DebugType>embedded</DebugType>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)LICENSE.md" Pack="true" PackagePath="LICENSE.md" Visible="false" />
  </ItemGroup>
</Project>

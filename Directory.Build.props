<Project>
  <PropertyGroup>
    <!-- The version RayMigrator is working towards (bumped right after each release, together with the
         Licensed Work line in LICENSE.md). Builds outside the release workflows are pre-releases of it:
         VersionSuffix "dev" plus the commit hash the SDK appends to the InformationalVersion, e.g.
         0.14.0-dev+39b6fa3. The release workflows pass -p:Version=<tag>, which replaces prefix and suffix. -->
    <RayMigratorVersion>0.14.0</RayMigratorVersion>
    <VersionPrefix>$(RayMigratorVersion)</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == ''">dev</VersionSuffix>
    <!-- NuGet Metadata (global for all packages) -->
    <Authors>Daniel Pavic (RAYCOON.com GmbH)</Authors>
    <Company>RAYCOON.com GmbH</Company>
    <Copyright>Copyright (c) 2023-$([System.DateTime]::Now.Year) RAYCOON.com GmbH</Copyright>
    <PackageProjectUrl>https://raymigrator.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/RAYCOON/RayMigrator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <DebugType>embedded</DebugType>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <!-- Composition property: per-project PackageTags include $(RayMigratorBaseTags). Do NOT set
         PackageTags directly here — that would shadow the per-project tag overrides (architecture
         review W2). -->
    <RayMigratorBaseTags>busl-1.1;source-available;database-migration;dotnet</RayMigratorBaseTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)LICENSE.md" Pack="true" PackagePath="LICENSE.md" Visible="false" />
  </ItemGroup>
</Project>

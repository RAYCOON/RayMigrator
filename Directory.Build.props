<Project>
  <PropertyGroup>
    <RayMigratorVersion>0.10.0</RayMigratorVersion>
    <Version>$(RayMigratorVersion)</Version>
    <!-- NuGet Metadata (global for all packages) -->
    <Authors>Daniel Pavic (RAYCOON.com GmbH)</Authors>
    <Company>RAYCOON.com GmbH</Company>
    <Copyright>Copyright (c) 2023-$([System.DateTime]::Now.Year) RAYCOON.com GmbH</Copyright>
    <PackageProjectUrl>https://raymigrator.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/RAYCOON/RayMigrator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <DebugType>embedded</DebugType>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReleaseNotes>
Version 0.10.0:
- License changed from BSL 1.1 to AGPL-3.0-only
- Dual licensing now offered:
  - AGPL for open source usage
  - Commercial license for production use without AGPL obligations
  - Free license for public sector and education
- Source files now contain AGPLv3 copyright headers
    </PackageReleaseNotes>
  </PropertyGroup>
</Project>

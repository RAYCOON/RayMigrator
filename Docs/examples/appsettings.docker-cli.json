{
  "RayMigrator": {
    "Repository": {
      "DatabaseType": "PostgreSQL",
      "ConnectionString": "Host=localhost;Port=5432;Database=raymigrator;Username=postgres;Password={ENV:POSTGRES_PASSWORD}",
      "SchemaName": "ray",
      "TableBaseName": ""
    },

    "CliTools": [
      {
        "Alias": "psql-docker",
        "ExecutablePath": "docker",
        "ArgumentTemplate": "exec -i rm_db_postgresql psql --set ON_ERROR_STOP=1 -U {User} -d {Database}",
        "InputMode": "Stdin",
        "SuccessExitCodes": ["0"],
        "CliToolTimeoutInSeconds": 30
      },
      {
        "Alias": "mariadb-docker",
        "ExecutablePath": "docker",
        "ArgumentTemplate": "exec -i rm_db_mariadb mariadb -u {User} -p{Password} {Database}",
        "InputMode": "Stdin",
        "SuccessExitCodes": ["0"],
        "CliToolTimeoutInSeconds": 30
      },
      {
        "Alias": "sqlcmd-docker",
        "ExecutablePath": "docker",
        "ArgumentTemplate": "exec -i rm_db_sqlserver /opt/mssql-tools18/bin/sqlcmd -S localhost -U sa -P {Password} -C -d {Database} -b",
        "InputMode": "Stdin",
        "SuccessExitCodes": ["0"],
        "CliToolTimeoutInSeconds": 30
      },
      {
        "Alias": "mysql-docker-file",
        "ExecutablePath": "/bin/bash",
        "ArgumentTemplate": "-c \"cat '{FilePath}' | docker exec -i rm_db_mysql mysql -u {User} -p{Password} {Database}\"",
        "InputMode": "File",
        "SuccessExitCodes": ["0"],
        "CliToolTimeoutInSeconds": 30
      }
    ],

    "ProductDefaults": {
      "MigrationErrorAction": "Terminate",
      "MigrationFilesExtension": "sql",
      "MigrationRollbackFilesPreExtension": "rollback",
      "MigrationFilesEncoding": "UTF-8",
      "RequireRollbackFile": true,
      "TargetGroupDefaults": {
        "TargetMigrationOrder": "Successively",
        "HashValidationScope": "File",
        "TargetDefaults": {
          "DbCommandTimeoutInSeconds": 30,
          "DbCommandMaxRetries": 0,
          "DbCommandWaitTimeInMsBeforeRetry": 250
        }
      }
    },

    "Products": [
      {
        "Alias": "DockerCliDemo",
        "MigrationFilesRootDirectory": "{ENV:MIGRATION_PATH}/DockerCliDemo",

        "TargetGroups": [
          {
            "Alias": "PostgresBackend",
            "DatabaseType": "PostgreSQL",
            "UseCliToolAlias": "psql-docker",
            "Targets": [
              {
                "Alias": "MainDB",
                "ConnectionString": "Host=localhost;Port=5432;Database=appdb;Username=postgres;Password={ENV:POSTGRES_PASSWORD}",
                "CliToolParameters": {
                  "User": "postgres",
                  "Database": "appdb"
                }
              }
            ]
          },
          {
            "Alias": "MariaDbBackend",
            "DatabaseType": "MariaDb",
            "UseCliToolAlias": "mariadb-docker",
            "Targets": [
              {
                "Alias": "MainDB",
                "ConnectionString": "Server=127.0.0.1;Port=3306;Database=appdb;User Id=appuser;Password={ENV:MARIADB_PASSWORD}",
                "CliToolParameters": {
                  "User": "appuser",
                  "Password": "{ENV:MARIADB_PASSWORD}",
                  "Database": "appdb"
                }
              }
            ]
          },
          {
            "Alias": "SqlServerBackend",
            "DatabaseType": "SqlServer",
            "UseCliToolAlias": "sqlcmd-docker",
            "Targets": [
              {
                "Alias": "MainDB",
                "ConnectionString": "Server=127.0.0.1,1433;Initial Catalog=AppDB;User Id=sa;Password={ENV:SA_PASSWORD};TrustServerCertificate=true",
                "CliToolParameters": {
                  "Password": "{ENV:SA_PASSWORD}",
                  "Database": "AppDB"
                }
              }
            ]
          },
          {
            "Alias": "MySqlAnalytics",
            "DatabaseType": "MySql",
            "UseCliToolAlias": "mysql-docker-file",
            "Targets": [
              {
                "Alias": "MainDB",
                "ConnectionString": "Server=127.0.0.1;Port=3307;Database=analytics;User Id=appuser;Password={ENV:MYSQL_PASSWORD}",
                "CliToolParameters": {
                  "User": "appuser",
                  "Password": "{ENV:MYSQL_PASSWORD}",
                  "Database": "analytics"
                }
              }
            ]
          }
        ]
      }
    ],

    "Serilog": {
      "MinimumLevel": {
        "Default": "Debug"
      },
      "WriteTo": [
        {
          "Name": "Console",
          "Args": {
            "outputTemplate": "{Timestamp:HH:mm:ss} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
          }
        }
      ]
    }
  }
}

<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>default</LangVersion>
        <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
        <PackageId>Raycoon.RayMigrator.Testing</PackageId>
        <Version>$(RayMigratorVersion)</Version>
        <Authors>RAYCOON.com GmbH</Authors>
        <Description>Reusable test infrastructure for RayMigrator integration tests. Licensed under BUSL-1.1 with Additional Use Grant — see LICENSE.md.</Description>
        <IsPackable>true</IsPackable>
        <PackageTags>$(RayMigratorBaseTags);raymigrator;testing;integration</PackageTags>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\NUGET_README.md" Pack="true" PackagePath="README.md" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Raycoon.RayMigrator.Database\Raycoon.RayMigrator.Database.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Raycoon.RayMigrator.Tests.Unit" />
    </ItemGroup>

</Project>

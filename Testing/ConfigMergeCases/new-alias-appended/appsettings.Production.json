{
  "RayMigrator": {
    "CliTools": [
      {
        "Alias": "psql",
        "ExecutablePath": "psql",
        "ArgumentTemplate": "-f {FilePath}",
        "InputMode": "File",
        "SuccessExitCodes": "0"
      },
      {
        "Alias": "SQLCMD",
        "InputMode": "Stdin"
      }
    ],
    "Products": [
      {
        "Alias": "Crm",
        "MigrationFilesRootDirectory": "./Migrations/Crm",
        "MigrationErrorAction": "Terminate",
        "TargetGroups": [
          {
            "Alias": "Backend",
            "DatabaseType": "Sqlite",
            "Targets": [
              {
                "Alias": "Main",
                "ConnectionString": "Data Source=crm.sqlite"
              }
            ]
          }
        ]
      }
    ]
  }
}

{
  "RayMigrator": {
    "Repository": {
      "DatabaseType": "Sqlite",
      "ConnectionString": "Data Source=repo.sqlite",
      "TableBaseName": ""
    },
    "Products": [
      {
        "Alias": "shop",
        "MigrationFilesRootDirectory": "./Migrations/Shop",
        "MigrationErrorAction": "Rollback",
        "MigrationFilesEncoding": "UTF-8",
        "TargetGroups": [
          {
            "Alias": "backend",
            "DatabaseType": "Sqlite",
            "HashValidationScope": "SqlBlocks",
            "Targets": [
              {
                "Alias": "MAIN",
                "ConnectionString": "Data Source=production.sqlite"
              }
            ]
          }
        ]
      }
    ]
  }
}

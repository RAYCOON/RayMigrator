{
  "Shop.Dev": {
    "RayMigrator": {
      "Repository": {
        "DatabaseType": "SqlServer",
        "ConnectionString": "{ENV:REPO}",
        "SchemaName": "ray",
        "TableBaseName": ""
      },
      "CliTools": [
        {
          "Alias": "sqlcmd",
          "ExecutablePath": "sqlcmd",
          "ArgumentTemplate": "-i {FilePath}",
          "InputMode": "File",
          "SuccessExitCodes": "0"
        }
      ],
      "Products": [
        {
          "Alias": "Shop",
          "TargetGroups": [
            {
              "Alias": "Backend",
              "DatabaseType": "SqlServer",
              "UseCliToolAlias": "sqlcmd",
              "Targets": [
                {
                  "Alias": "Main",
                  "ConnectionString": "{ENV:SHOP_DEV}"
                }
              ]
            }
          ]
        }
      ],
      "Serilog": {
        "MinimumLevel": {
          "Default": "Information"
        },
        "WriteTo": [
          {
            "Name": "Console"
          }
        ]
      }
    }
  },
  "Shop.Prod": {
    "RayMigrator": {
      "Repository": {
        "DatabaseType": "SqlServer",
        "ConnectionString": "{ENV:REPO}",
        "SchemaName": "ray",
        "TableBaseName": ""
      },
      "CliTools": [
        {
          "Alias": "sqlcmd",
          "ExecutablePath": "sqlcmd",
          "ArgumentTemplate": "-i {FilePath}",
          "InputMode": "Stdin",
          "SuccessExitCodes": "0"
        }
      ],
      "Products": [
        {
          "Alias": "Shop",
          "TargetGroups": [
            {
              "Alias": "Backend",
              "DatabaseType": "SqlServer",
              "UseCliToolAlias": "sqlcmd",
              "Targets": [
                {
                  "Alias": "Main",
                  "ConnectionString": "{ENV:SHOP_PROD}"
                }
              ]
            }
          ]
        }
      ],
      "Serilog": {
        "MinimumLevel": {
          "Default": "Warning"
        },
        "WriteTo": [
          {
            "Name": "Console"
          },
          {
            "Name": "File",
            "Args": {
              "path": "logs/rm-.txt"
            }
          }
        ]
      }
    }
  }
}

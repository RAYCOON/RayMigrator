{
  "RayMigrator": {
    "Repository": {
      "DatabaseType": "SqlServer",
      "ConnectionString": "{ENV:REPO}",
      "SchemaName": "ray",
      "TableBaseName": ""
    },
    "CliTools": [
      {
        "Alias": "sqlcmd",
        "ExecutablePath": "sqlcmd",
        "ArgumentTemplate": "-i {FilePath}",
        "SuccessExitCodes": "0"
      }
    ],
    "Products": [
      {
        "Alias": "Shop",
        "TargetGroups": [
          {
            "Alias": "Backend",
            "DatabaseType": "SqlServer",
            "UseCliToolAlias": "sqlcmd",
            "Targets": [
              {
                "Alias": "Main"
              }
            ]
          }
        ]
      }
    ]
  }
}

{
  "RayMigrator": {
    "CliTools": [
      {
        "Alias": "sqlcmd",
        "InputMode": "Stdin"
      }
    ],
    "Serilog": {
      "MinimumLevel": {
        "Default": "Warning"
      },
      "WriteTo": [
        {
          "Name": "Console"
        },
        {
          "Name": "File",
          "Args": {
            "path": "logs/rm-.txt"
          }
        }
      ]
    }
  }
}

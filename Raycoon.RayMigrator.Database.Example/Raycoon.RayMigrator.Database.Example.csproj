<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>default</LangVersion>
        <RayMigratorDatabaseType>Example</RayMigratorDatabaseType>
        <!-- IsPackable=false because this skeleton is not published to NuGet — it's meant to be
             copied as a starting point for external DAL plugin developers. -->
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <!-- Permissive MIT carve-out for this directory. The MIT-licensed LICENSE.md inside this
         folder governs anyone who copies the skeleton. Properties below activate only if
         IsPackable is later flipped to true; otherwise dormant. The Condition guard prevents
         a NU5048 collision with the global <None Include="$(MSBuildThisFileDirectory)LICENSE.md">
         from Directory.Build.props (architecture review C1+C2). -->
    <PropertyGroup Condition="'$(IsPackable)' == 'true'">
        <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    </PropertyGroup>

    <ItemGroup Condition="'$(IsPackable)' == 'true'">
        <None Remove="$(MSBuildThisFileDirectory)..\LICENSE.md" />
        <None Include="LICENSE.md" Pack="true" PackagePath="LICENSE.md" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Raycoon.RayMigrator.Database.Common\Raycoon.RayMigrator.Database.Common.csproj" />
        <ProjectReference Include="..\Raycoon.RayMigrator.Shared\Raycoon.RayMigrator.Shared.csproj" />
    </ItemGroup>

    <!-- TODO: Add your database driver NuGet package here, e.g.:
    <ItemGroup>
        <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="..." />
    </ItemGroup>
    -->

    <!-- Templates als Content (transitiv propagiert + NuGet contentFiles) -->
    <ItemGroup>
        <Content Include="Templates\**\*.sql">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Link>DataAccessLayers\$(RayMigratorDatabaseType)\%(RecursiveDir)%(Filename)%(Extension)</Link>
            <Pack>true</Pack>
            <PackagePath>contentFiles\any\any\DataAccessLayers\$(RayMigratorDatabaseType)\</PackagePath>
            <PackageCopyToOutput>true</PackageCopyToOutput>
        </Content>
    </ItemGroup>

    <!-- DAL-DLL in DataAccessLayers/{Type}/ kopieren -->
    <Target Name="CopyDalToDataAccessLayers" AfterTargets="Build">
        <MakeDir Directories="$(OutputPath)DataAccessLayers\$(RayMigratorDatabaseType)" />
        <Copy SourceFiles="$(TargetPath)"
              DestinationFolder="$(OutputPath)DataAccessLayers\$(RayMigratorDatabaseType)\"
              SkipUnchangedFiles="true" />
    </Target>

</Project>

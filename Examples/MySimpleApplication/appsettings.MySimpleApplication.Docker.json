{
  "RayMigrator": {
    "Repository": {
      "DatabaseType": "SqlServer",
      "ConnectionString": "Server=localhost,14330;Initial Catalog=RayMigratorRepository;User Id=sa;Password={ENV:SA_PASSWORD};TrustServerCertificate=true",
      "SchemaName": "ray"
    },
    "Products": [
      {
        "Alias": "MySimpleApplication",
        "MigrationFilesRootDirectory": "./Examples/MySimpleApplication/Migrations/MySimpleApplication",
        "MigrationErrorAction": "Terminate",
        "MigrationFilesExtension": "sql",
        "MigrationRollbackFilesPreExtension": "rollback",
        "RequireRollbackFile": true,
        "TargetGroups": [
          {
            "Alias": "ApplicationTargetGroup",
            "DatabaseType": "SqlServer",
            "TargetMigrationOrder": "Successively",
            "HashValidationScope": "File",
            "Targets": [
              {
                "Alias": "ApplicationDB",
                "ConnectionString": "Server=localhost,14330;Initial Catalog=SimpleApplicationDB;User Id=sa;Password={ENV:SA_PASSWORD};TrustServerCertificate=true",
                "DbCommandTimeoutInSeconds": 30
              }
            ]
          }
        ]
      }
    ],
    "Serilog": {
      "MinimumLevel": { "Default": "Information" },
      "WriteTo": [{ "Name": "Console", "Args": { "outputTemplate": "{Timestamp:HH:mm:ss} [{Level:u3}] {Message:lj}{NewLine}{Exception}" } }]
    }
  }
}

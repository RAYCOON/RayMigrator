{
  "RayMigrator": {
    "Repository": {
      "DatabaseType": "SqlServer",
      "ConnectionString": "Server=localhost,14330;Initial Catalog=RayMigratorRepository;User Id=sa;Password={ENV:SA_PASSWORD};TrustServerCertificate=true",
      "SchemaName": "ray"
    },
    "Products": [
      {
        "Alias": "MyComplexApplication",
        "MigrationFilesRootDirectory": "./Examples/MyComplexApplication/Migrations/MyComplexApplication",
        "MigrationErrorAction": "Terminate",
        "MigrationFilesExtension": "sql",
        "MigrationRollbackFilesPreExtension": "rollback",
        "RequireRollbackFile": true,
        "TargetGroups": [
          {
            "Alias": "FrontendTargetGroup",
            "DatabaseType": "PostgreSQL",
            "TargetMigrationOrder": "Successively",
            "HashValidationScope": "File",
            "Targets": [
              {
                "Alias": "FrontendDB",
                "ConnectionString": "Host=localhost;Port=54320;Database=FrontendDB;Username=rayuser;Password={ENV:POSTGRES_EXAMPLE_PASSWORD}",
                "DbCommandTimeoutInSeconds": 30
              }
            ]
          },
          {
            "Alias": "BackendTargetGroup",
            "DatabaseType": "SqlServer",
            "TargetMigrationOrder": "Successively",
            "HashValidationScope": "File",
            "Targets": [
              {
                "Alias": "BackendDB",
                "ConnectionString": "Server=localhost,14330;Initial Catalog=BackendDB;User Id=sa;Password={ENV:SA_PASSWORD};TrustServerCertificate=true",
                "DbCommandTimeoutInSeconds": 30
              }
            ]
          }
        ]
      }
    ],
    "Serilog": {
      "MinimumLevel": { "Default": "Information" },
      "WriteTo": [{ "Name": "Console", "Args": { "outputTemplate": "{Timestamp:HH:mm:ss} [{Level:u3}] {Message:lj}{NewLine}{Exception}" } }]
    }
  }
}

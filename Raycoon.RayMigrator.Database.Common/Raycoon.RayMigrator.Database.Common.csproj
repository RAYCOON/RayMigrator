<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>default</LangVersion>
        <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
        <PackageId>Raycoon.RayMigrator.Database.Common</PackageId>
        <Version>$(RayMigratorVersion)</Version>
        <Authors>RAYCOON.com GmbH</Authors>
        <Description>Database abstractions and base classes for RayMigrator DAL plugins. Licensed under BUSL-1.1 with Additional Use Grant — see LICENSE.md.</Description>
        <IsPackable>true</IsPackable>
        <PackageTags>$(RayMigratorBaseTags);raymigrator;database;dal;migration</PackageTags>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\NUGET_README.md" Pack="true" PackagePath="README.md" />
    </ItemGroup>

</Project>


@* Modal dialog displaying detailed help for a configuration field. *@

@using Raycoon.RayMigrator.ConfigWizard.Core.Models

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Outlined.HelpOutline" Color="Color.Primary" />
            <MudText Typo="Typo.h6">@Help.Title</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudText Typo="Typo.body1">@Help.Description</MudText>

            @if (Help.ValidValues is not null)
            {
                <div>
                    <MudText Typo="Typo.subtitle2" Class="mb-1">@L.Get("Help.ValidValues")</MudText>
                    <MudText Typo="Typo.body2">@Help.ValidValues</MudText>
                </div>
            }

            @if (Help.DefaultValue is not null)
            {
                <div>
                    <MudText Typo="Typo.subtitle2" Class="mb-1">@L.Get("Help.Default")</MudText>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@Help.DefaultValue</MudChip>
                </div>
            }

            @if (Help.Examples is not null)
            {
                <div>
                    <MudText Typo="Typo.subtitle2" Class="mb-1">@L.Get("Help.Examples")</MudText>
                    <MudText Typo="Typo.body2" Style="white-space: pre-line">@Help.Examples</MudText>
                </div>
            }

            @if (Help.InheritanceNote is not null)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                    <MudText Typo="Typo.body2">@Help.InheritanceNote</MudText>
                </MudAlert>
            }

            @if (Help.JsonPath is not null)
            {
                <div>
                    <MudText Typo="Typo.subtitle2" Class="mb-1">@L.Get("Help.JsonConfigPath")</MudText>
                    <MudText Typo="Typo.body2">@Help.JsonPath.ConfigPath</MudText>
                </div>

                @if (Help.JsonPath.InheritedByPaths is { Count: > 0 })
                {
                    <div class="mt-2">
                        <MudText Typo="Typo.subtitle2" Class="mb-1">@L.Get("Help.InheritedBy")</MudText>
                        @foreach (var path in Help.JsonPath.InheritedByPaths)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Default" Style="color: var(--mud-palette-text-secondary)">@path</MudText>
                        }
                    </div>
                }

                @if (Help.JsonPath.InheritedFromPath is not null)
                {
                    <div class="mt-2">
                        <MudText Typo="Typo.subtitle2" Class="mb-1">@L.Get("Common.InheritedFrom")</MudText>
                        <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary)">@Help.JsonPath.InheritedFromPath</MudText>
                    </div>
                }
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Variant="Variant.Filled" Color="Color.Primary">
            @L.Get("Common.Close")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public FieldHelp Help { get; set; } = default!;

    [Inject] private LocalizationService L { get; set; } = default!;

    private void Close() => MudDialog.Close();
}

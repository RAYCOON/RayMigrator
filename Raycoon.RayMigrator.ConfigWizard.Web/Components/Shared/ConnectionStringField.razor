@* A text field for connection strings with ENV placeholder support hint. *@

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
    <MudTextField T="string" Value="@Value" ValueChanged="ValueChanged"
                  Label="@L.Get("Common.ConnectionString")"
                  Variant="Variant.Outlined"
                  HelperText="Use {ENV:VARIABLE_NAME} for environment variable placeholders"
                  Adornment="Adornment.End"
                  AdornmentIcon="@Icons.Material.Outlined.Link"
                  FullWidth="true" />
    @if (!string.IsNullOrEmpty(FieldKey))
    {
        <FieldHelpIcon FieldKey="@FieldKey" />
    }
</MudStack>

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string FieldKey { get; set; } = "";

    [Inject] private LocalizationService L { get; set; } = default!;
}

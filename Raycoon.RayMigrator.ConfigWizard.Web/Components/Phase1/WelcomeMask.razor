@* Mask 1: Welcome screen with Create New / Upload Existing as two cards. *@

<MudContainer MaxWidth="MaxWidth.Medium">
    <MudStack Spacing="4" AlignItems="AlignItems.Center" Class="mt-8 mb-6">
        <MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Large" Color="Color.Primary" />
        <MudText Typo="Typo.h4" Align="Align.Center">@L.Get("Welcome.Title")</MudText>
        <MudText Typo="Typo.body1" Align="Align.Center">
            @L.Get("Welcome.Subtitle")
        </MudText>
    </MudStack>

    <MudGrid Spacing="4" Justify="Justify.Center">
        @* Card 1: Create New *@
        <MudItem xs="12" md="6">
            <MudCard Elevation="2" Style="height:100%;">
                <MudCardContent>
                    <MudStack Spacing="3" AlignItems="AlignItems.Center" Class="pa-4">
                        <MudIcon Icon="@Icons.Material.Filled.NoteAdd" Size="Size.Large" Color="Color.Primary" />
                        <MudText Typo="Typo.h6" Align="Align.Center">@L.Get("Welcome.CreateNew")</MudText>
                        <MudText Typo="Typo.body2" Align="Align.Center">
                            @L.Get("Welcome.CreateNewDescription")
                        </MudText>
                        <MudStack Spacing="2" AlignItems="AlignItems.Center" Style="color:#2e7d32;">
                            <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Color="Color.Inherit" />
                            <MudText Typo="Typo.caption" Align="Align.Center" Color="Color.Inherit">
                                @L.Get("Welcome.CreatePrivacy")
                            </MudText>
                        </MudStack>
                    </MudStack>
                </MudCardContent>
                <MudCardActions Class="justify-center pb-6">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               Size="Size.Large"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="OnCreateNew">
                        @L.Get("Welcome.CreateNew")
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        @* Card 2: Upload Existing *@
        <MudItem xs="12" md="6">
            <MudCard Elevation="2" Style="height:100%;">
                <MudCardContent>
                    <MudStack Spacing="3" AlignItems="AlignItems.Center" Class="pa-4">
                        <MudIcon Icon="@Icons.Material.Filled.UploadFile" Size="Size.Large" Color="Color.Primary" />
                        <MudText Typo="Typo.h6" Align="Align.Center">@L.Get("Welcome.UploadExisting")</MudText>
                        <MudText Typo="Typo.body2" Align="Align.Center">
                            @L.Get("Welcome.UploadDescription")
                        </MudText>
                        <MudStack Spacing="2" AlignItems="AlignItems.Center" Style="color:#2e7d32;">
                            <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Color="Color.Inherit" />
                            <MudText Typo="Typo.caption" Align="Align.Center" Color="Color.Inherit">
                                @L.Get("Welcome.UploadPrivacy")
                            </MudText>
                        </MudStack>
                    </MudStack>
                </MudCardContent>
                <MudCardActions Class="justify-center pb-6">
                    <MudStack Spacing="2" AlignItems="AlignItems.Center">
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                   Size="Size.Large"
                                   StartIcon="@Icons.Material.Filled.Upload"
                                   HtmlTag="label" for="fileUploadInput">
                            @L.Get("Welcome.SelectFiles")
                        </MudButton>
                        <InputFile id="fileUploadInput" OnChange="OnInputFileChanged"
                                   accept=".json" multiple hidden />

                        @if (_uploadedFiles.Count > 0)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Success">
                                @_uploadedFiles.Count @L.Get("Upload.FilesLoaded")
                            </MudText>
                            <MudStack Row="true" Spacing="2" Justify="Justify.Center">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                           OnClick="OnGoToOverview">
                                    @L.Get("Welcome.GoToOverview")
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                           OnClick="OnWalkThrough">
                                    @L.Get("Welcome.WalkThrough")
                                </MudButton>
                            </MudStack>
                        }
                    </MudStack>
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>

    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-4" Style="max-width:900px; margin:0 auto;">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Lightbulb" Size="Size.Small" />
            <MudText Typo="Typo.body2">@L.Get("Mode.EasyModeHint")</MudText>
        </MudStack>
    </MudAlert>
</MudContainer>

@code {
    [Parameter] public EventCallback OnCreateNewClicked { get; set; }
    [Parameter] public EventCallback OnGoToOverviewClicked { get; set; }
    [Parameter] public EventCallback OnWalkThroughClicked { get; set; }

    [Inject] private LocalizationService L { get; set; } = default!;
    [Inject] private WizardStateService Wizard { get; set; } = default!;

    private readonly Dictionary<string, string> _uploadedFiles = new();

    private async Task OnCreateNew()
    {
        await OnCreateNewClicked.InvokeAsync();
    }

    private async Task OnInputFileChanged(InputFileChangeEventArgs e)
    {
        _uploadedFiles.Clear();
        foreach (var file in e.GetMultipleFiles(20))
        {
            try
            {
                using var reader = new StreamReader(file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024));
                var content = await reader.ReadToEndAsync();
                _uploadedFiles[file.Name] = content;
            }
            catch
            {
                // Skip files that cannot be read
            }
        }

        if (_uploadedFiles.Count > 0)
        {
            Wizard.ImportFiles(_uploadedFiles);
        }
    }

    private async Task OnGoToOverview()
    {
        await OnGoToOverviewClicked.InvokeAsync();
    }

    private async Task OnWalkThrough()
    {
        await OnWalkThroughClicked.InvokeAsync();
    }

}

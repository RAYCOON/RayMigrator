
@inherits LayoutComponentBase
@implements IDisposable

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary">
        <div style="display: flex; align-items: baseline;" class="ml-3">
            <MudText Typo="Typo.h6">RayMigrator Config Wizard</MudText>
            <MudText Typo="Typo.caption" Style="margin-left: 20px; opacity: 0.85;">v@(_version)</MudText>
        </div>
        <MudSpacer />
        <LanguageSwitch />
    </MudAppBar>
    <MudMainContent Class="pt-16 pa-4 pb-16">
        <div @key="@_languageVersion">
            @Body
        </div>
    </MudMainContent>
    <footer class="pa-4" style="text-align: center;">
        <MudText Typo="Typo.caption" Style="opacity: 0.7;">
            © 2023–@DateTime.UtcNow.Year RAYCOON.com GmbH ·
            <MudLink Href="https://github.com/RAYCOON/RayMigrator/blob/main/LICENSE.md"
                     Target="_blank" Typo="Typo.caption">BUSL-1.1</MudLink> ·
            <MudLink Href="https://raymigrator.com" Target="_blank" Typo="Typo.caption">raymigrator.com</MudLink>
        </MudText>
    </footer>
</MudLayout>

@code {
    [Inject] private LocalizationService L { get; set; } = default!;

    private int _languageVersion;

    private static readonly string _version =
        typeof(MainLayout).Assembly.GetName().Version?.ToString(3) ?? "";

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#2196F3"
        }
    };

    protected override void OnInitialized()
    {
        L.LanguageChanged += OnLanguageChanged;
    }

    private void OnLanguageChanged()
    {
        _languageVersion++;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        L.LanguageChanged -= OnLanguageChanged;
    }
}

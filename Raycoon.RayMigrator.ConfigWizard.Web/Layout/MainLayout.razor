@inherits LayoutComponentBase
@implements IDisposable

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary">
        <div style="display: flex; align-items: baseline;" class="ml-3">
            <MudText Typo="Typo.h6">RayMigrator Config Wizard</MudText>
            <MudText Typo="Typo.caption" Style="margin-left: 20px; opacity: 0.85;">v@(_version)</MudText>
        </div>
        <MudSpacer />
        <LanguageSwitch />
    </MudAppBar>
    <MudMainContent Class="pt-16 pa-4 pb-16">
        <div @key="@_languageVersion">
            @Body
        </div>
    </MudMainContent>
</MudLayout>

@code {
    [Inject] private LocalizationService L { get; set; } = default!;

    private int _languageVersion;

    private static readonly string _version =
        typeof(MainLayout).Assembly.GetName().Version?.ToString(3) ?? "";

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#2196F3"
        }
    };

    protected override void OnInitialized()
    {
        L.LanguageChanged += OnLanguageChanged;
    }

    private void OnLanguageChanged()
    {
        _languageVersion++;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        L.LanguageChanged -= OnLanguageChanged;
    }
}


@page "/"
@implements IDisposable

@* Single-page host for all wizard phases (Start → Hub → GuidedConfig → Overview). *@

<ProgressIndicator CurrentPhase="@Wizard.CurrentPhase" />

@switch (Wizard.CurrentPhase)
{
    case WizardPhase.Start:
        <WelcomeMask OnCreateNewClicked="OnCreateNew"
                     OnGoToOverviewClicked="GoToHubFromImport"
                     OnWalkThroughClicked="GoToHubFromImport" />
        break;

    case WizardPhase.Hub:
        <HubPage />
        break;

    case WizardPhase.GuidedConfig:
        <WizardHost />
        break;

    case WizardPhase.Overview:
        <OverviewHost />
        break;
}

@code {
    [Inject] private WizardStateService Wizard { get; set; } = default!;

    protected override void OnInitialized()
    {
        Wizard.StateChanged += StateHasChanged;
    }

    private void OnCreateNew() => Wizard.StartNewConfiguration();
    private void GoToHubFromImport() => Wizard.GoToHub();

    public void Dispose()
    {
        Wizard.StateChanged -= StateHasChanged;
    }
}
